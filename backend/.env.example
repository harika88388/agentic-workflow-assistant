APP_ENV=development
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- LLM (Phase 6) ---
OPENROUTER_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=openrouter            # openrouter | gemini
LLM_MODEL=deepseek/deepseek-r1
# Optional per-responsibility overrides (blank = use LLM_PROVIDER / LLM_MODEL).
# If a provider override differs from LLM_PROVIDER you must also set that role's model.
INTENT_LLM_PROVIDER=
INTENT_LLM_MODEL=
SUMMARY_LLM_PROVIDER=
SUMMARY_LLM_MODEL=
TASK_LLM_PROVIDER=
TASK_LLM_MODEL=

# --- MCP ---
# stdio = Gmail/Calendar MCP servers run as subprocesses (default); inprocess = in-memory MCP transport
MCP_TRANSPORT=stdio
MCP_TIMEOUT_SECONDS=60
