APP_ENV=development
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- OpenRouter / DeepSeek ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_JSON_MODE=false

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Shared LLM routing ---
LLM_PROVIDER=openrouter            # openrouter | gemini
LLM_MODEL=deepseek/deepseek-r1-0528
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096

# Optional per-responsibility overrides (blank = use LLM_PROVIDER / LLM_MODEL).
# If a provider override differs from LLM_PROVIDER, set a model for that role.
INTENT_LLM_PROVIDER=
INTENT_LLM_MODEL=
SUMMARY_LLM_PROVIDER=
SUMMARY_LLM_MODEL=
TASK_LLM_PROVIDER=
TASK_LLM_MODEL=

# --- MCP ---
# stdio = Gmail/Calendar MCP servers run as subprocesses (default).
# inprocess = in-memory MCP transport used by tests and single-process deployments.
MCP_TRANSPORT=stdio
MCP_TIMEOUT_SECONDS=60
